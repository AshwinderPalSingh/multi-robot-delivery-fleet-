Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Cell Size: 1
      Color: 160; 160; 164
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/Map
      Name: Hospital Map
      Enabled: true
      Topic:
        Value: /rover1/map
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: false
      Use Timestamp: false

    # The central brain's own view of the fleet: station markers sized by
    # demand weight (what factor F7 integrates over), a live label per rover
    # showing battery / current task / reliability / pose sigma, and the
    # committed path of every rover currently on a mission -- which is
    # exactly the set factor F3 forecasts contention against.
    - Class: rviz_default_plugins/MarkerArray
      Name: Fleet Brain
      Enabled: true
      Topic:
        Value: /fleet/markers
        Depth: 20
        Durability Policy: Volatile
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        rover1/base_link:
          Value: true
        rover2/base_link:
          Value: true
        rover3/base_link:
          Value: true
        rover4/base_link:
          Value: true
        map:
          Value: true

    - Class: rviz_default_plugins/LaserScan
      Name: rover1 LiDAR
      Enabled: true
      Topic:
        Value: /rover1/scan
        Depth: 5
        Reliability Policy: Best Effort
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 0; 255; 0
      Style: Points

    - Class: rviz_default_plugins/RobotModel
      Name: rover1 Model
      Enabled: true
      Description Topic:
        Value: /rover1/robot_description
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      TF Prefix: rover1

    - Class: rviz_default_plugins/Path
      Name: rover1 Plan
      Enabled: true
      Topic:
        Value: /rover1/plan
        Depth: 5
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Line Style: Lines
      Alpha: 0.9

    - Class: rviz_default_plugins/LaserScan
      Name: rover2 LiDAR
      Enabled: true
      Topic:
        Value: /rover2/scan
        Depth: 5
        Reliability Policy: Best Effort
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 140; 0
      Style: Points

    - Class: rviz_default_plugins/RobotModel
      Name: rover2 Model
      Enabled: true
      Description Topic:
        Value: /rover2/robot_description
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      TF Prefix: rover2

    - Class: rviz_default_plugins/Path
      Name: rover2 Plan
      Enabled: true
      Topic:
        Value: /rover2/plan
        Depth: 5
        Reliability Policy: Reliable
      Color: 255; 140; 0
      Line Style: Lines
      Alpha: 0.9

    - Class: rviz_default_plugins/LaserScan
      Name: rover3 LiDAR
      Enabled: true
      Topic:
        Value: /rover3/scan
        Depth: 5
        Reliability Policy: Best Effort
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 0; 200; 255
      Style: Points

    - Class: rviz_default_plugins/RobotModel
      Name: rover3 Model
      Enabled: true
      Description Topic:
        Value: /rover3/robot_description
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      TF Prefix: rover3

    - Class: rviz_default_plugins/Path
      Name: rover3 Plan
      Enabled: true
      Topic:
        Value: /rover3/plan
        Depth: 5
        Reliability Policy: Reliable
      Color: 0; 200; 255
      Line Style: Lines
      Alpha: 0.9

    - Class: rviz_default_plugins/LaserScan
      Name: rover4 LiDAR
      Enabled: true
      Topic:
        Value: /rover4/scan
        Depth: 5
        Reliability Policy: Best Effort
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 0; 200
      Style: Points

    - Class: rviz_default_plugins/RobotModel
      Name: rover4 Model
      Enabled: true
      Description Topic:
        Value: /rover4/robot_description
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      TF Prefix: rover4

    - Class: rviz_default_plugins/Path
      Name: rover4 Plan
      Enabled: true
      Topic:
        Value: /rover4/plan
        Depth: 5
        Reliability Policy: Reliable
      Color: 255; 0; 200
      Line Style: Lines
      Alpha: 0.9

  Global Options:
    Background Color: 40; 42; 48
    Fixed Frame: map
    Frame Rate: 30

  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    # "2D Goal Pose" goes to /goal_pose, which task_console picks up and turns
    # into a FleetTask. It does NOT go to any rover: the brain decides who
    # takes it. Drop a goal near a station and it is labelled with that
    # station's name; drop it anywhere else and it goes through as a raw pose.
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    # One "2D Pose Estimate" per rover, in toolbar order rover1..rover4.
    # AMCL lives inside each rover's namespace and listens on
    # /roverX/initialpose, so a single un-namespaced tool would have zero
    # subscribers and silently do nothing.
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /rover1/initialpose
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /rover2/initialpose
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /rover3/initialpose
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /rover4/initialpose

  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
      Near Clip Distance: 0.01
      Scale: 22
      X: 1.5
      Y: 4.5

Window Geometry:
  Width: 1600
  Height: 950
  Displays:
    collapsed: false
