      <static>true</static><pose>-9.0 10.5 0.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.4</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.5 0.4</size></box></geometry>
          <material><ambient>0.72 0.55 0.3 1</ambient><diffuse>0.72 0.55 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="supply_box_2">
      <static>true</static><pose>-8.3 10.5 0.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.4</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.5 0.4</size></box></geometry>
          <material><ambient>0.72 0.55 0.3 1</ambient><diffuse>0.72 0.55 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="supply_box_3">
      <static>true</static><pose>-7.6 10.5 0.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.4</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.5 0.4</size></box></geometry>
          <material><ambient>0.72 0.55 0.3 1</ambient><diffuse>0.72 0.55 0.3 1</diffuse></material>
