    <!-- Medicine box on floor -->
    <!-- <model name="medicine_box">
      <static>true</static><pose>-2 1.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>1.0 0.3 0.3 1</ambient><diffuse>1.0 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model> -->

    <!-- Wheelchair parked -->
    <model name="wheelchair">
      <static>true</static><pose>-8 3.5 0.45 0 0 0.3</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.6 0.9 0.9</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.6 0.9 0.9</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== SIGNAGE (at 1.5m height) ===== -->

    <!-- Room 1 sign -->
    <model name="sign_room1">
      <static>true</static><pose>0 3.05 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.02 0.15</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 0.02 0.15</size></box></geometry>
          <material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Room 2 sign -->
    <model name="sign_room2">
      <static>true</static><pose>6 3.05 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.02 0.15</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 0.02 0.15</size></box></geometry>
          <material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Charging bay sign -->
    <model name="sign_charging">
      <static>true</static><pose>-7 -3.05 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.02 0.15</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.02 0.15</size></box></geometry>
          <material><ambient>0.1 0.7 0.1 1</ambient><diffuse>0.1 0.7 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== PEOPLE (static obstacles) =====
         Originally three <actor> blocks whose skin/animation meshes were
         Ignition Fuel URLs. Under Gazebo Classic those URLs download an
         invalid COLLADA file, and Classic's ColladaLoader then segfaults
         the server ("Missing COLLADA tag" -> core dump).

         The original block was also malformed: XML comments cannot nest,
         so the "<!-- Actor 3" comment on the old line 592 silently closed
         the comment opened at the old line 566. Only roamer_1 was actually
         disabled; the receptionist and patient were live despite appearing
         commented out, and a stray "-->" dangled at the end of the block.

         Both live actors are reproduced below as static cylinder models
         with the same poses and the same 0.3 m x 1.8 m collision geometry
         they already declared, so they remain physical obstacles for
         navigation and stuck-recovery testing with no mesh dependency.
         roamer_1 stays disabled, as originally intended. -->

    <model name="person_reception">
      <static>true</static>
      <pose>1.0 1.8 0.9 0 0 3.14</pose>
      <link name="body">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.8</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.35 0.55 1</ambient>
            <diffuse>0.2 0.35 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="person_patient">
      <static>true</static>
      <pose>1.5 -1.0 0.9 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.8</length></cylinder></geometry>
          <material>
            <ambient>0.55 0.3 0.3 1</ambient>
            <diffuse>0.55 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
