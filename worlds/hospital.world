    </model>

    <!-- Privacy curtain rail room 1 -->
    <model name="curtain_rail_1">
      <static>true</static><pose>-1 9.0 2.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.02</radius><length>3.0</length></cylinder></geometry>
          <pose>0 0 0 0 1.5708 0</pose>
        </collision>
        <visual name="vis">
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>3.0</length>
