          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- IV Bag -->
    <model name="iv_bag_1">
      <static>true</static><pose>-2.0 10.5 1.85 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 0.05 0.25</size></box></geometry></collision>
