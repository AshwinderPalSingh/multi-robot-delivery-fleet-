<?xml version="1.0" ?>
<!-- Gazebo Classic 11 world.
     Converted from the original Ignition/Fortress version, which is kept
     alongside as hospital.world.ignition-backup.

     Classic 11 parses SDF only up to 1.7 and rejected the 1.8 header
     ("Unable to convert from SDF version 1.8 to 1.7"). It also has no
     "ignored" physics type -- that is an Ignition convention where the
     engine is supplied by a system plugin instead ("Invalid Physics
     Type[ignored]" -> "Unable to create physics engine"). Either error
     alone aborts world load, which is why gzserver exited at startup.

     Physics, sensors, scene broadcasting and user commands are all built
     into gzserver, so the ignition-gazebo-*-system plugins have no Classic
     equivalent and are dropped. The ROS interface plugins
     (libgazebo_ros_init / _factory / _force_system) are injected by
     gazebo_ros's own gzserver launch file via -s arguments, so they must
     not be listed here either. -->
<sdf version="1.6">
  <world name="hospital">

    <!-- ===== PHYSICS ===== -->
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ===== LIGHTING (Hospital Cool White 6000K) ===== -->
    <light name="main_light_1" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.95 0.97 1.0 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.0 0.0 -1.0</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="corridor_light_1" type="point">
      <pose>0 0 3.8 0 0 0</pose>
      <diffuse>0.95 0.97 1.0 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>10</range><linear>0.1</linear><constant>0.5</constant></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="corridor_light_2" type="point">
      <pose>8 0 3.8 0 0 0</pose>
      <diffuse>0.95 0.97 1.0 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>10</range><linear>0.1</linear><constant>0.5</constant></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="reception_light" type="point">
      <pose>-8 4 3.8 0 0 0</pose>
      <diffuse>0.95 0.97 1.0 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation><range>8</range><linear>0.1</linear><constant>0.5</constant></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ===== GROUND (Linoleum Floor) ===== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material>
            <ambient>0.88 0.88 0.85 1</ambient>
            <diffuse>0.88 0.88 0.85 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!--                     HOSPITAL STRUCTURE                            -->
    <!-- L-SHAPED LAYOUT:                                                  -->
    <!--  Main corridor runs East-West (y=0, x=-10 to x=12)               -->
    <!--  Branch corridor runs North (x=-10, y=0 to y=12)                 -->
    <!--  Reception: top-left                                              -->
    <!--  Patient Rooms: along top corridor                                -->
    <!--  Operating Theater: end of east corridor                          -->
    <!--  Charging Bay: south side                                         -->
    <!--  Nurses Station: center junction                                  -->
    <!-- ================================================================ -->

    <!-- ===== OUTER BOUNDARY WALLS ===== -->

    <!-- North wall (top) -->
    <model name="wall_north">
      <static>true</static><pose>1 12 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>22 0.2 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>22 0.2 3</size></box></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static><pose>1 -6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>22 0.2 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>22 0.2 3</size></box></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="wall_west">
      <static>true</static><pose>-10 3 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 18 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 18 3</size></box></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="wall_east">
      <static>true</static><pose>12 3 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 18 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 18 3</size></box></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- ===== MAIN CORRIDOR WALLS (East-West, y=0 center, width=3m) ===== -->

    <!-- Corridor north wall segment east -->
    <model name="corridor_north_east">
      <static>true</static><pose>6 3 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>12 0.2 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>12 0.2 3</size></box></geometry>
          <material><ambient>0.90 0.90 0.92 1</ambient><diffuse>0.90 0.90 0.92 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- ===== RECEPTION AREA (x=-10 to -7, y=3 to 12) ===== -->

    <!-- Supply table -->
    <model name="supply_table">
      <static>true</static><pose>-8.5 8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.5 0.6 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>2.5 0.6 1.0</size></box></geometry>
          <material><ambient>0.6 0.5 0.3 1</ambient><diffuse>0.6 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Supply side panel -->
    <model name="supply_side">
      <static>true</static><pose>-7.4 7.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.6 2.0 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.6 2.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.5 0.3 1</ambient><diffuse>0.6 0.5 0.3 1</diffuse></material>
