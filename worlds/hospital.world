    <!-- Bedside table room 1 -->
    <model name="bedside_table_1">
      <static>true</static><pose>0.3 10 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 0.4 0.8</size></box></geometry>
