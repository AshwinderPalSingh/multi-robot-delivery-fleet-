    <!-- ===== NURSES STATION (center, x=-1 to 3, y=-1 to 3) ===== -->
    <model name="nurses_desk_main">
      <static>true</static><pose>1 1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.5 0.6 1.0</size></box></geometry></collision>
