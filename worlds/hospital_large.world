        </visual>
      </link>
    </model>

    <!-- Bed pillow -->
    <model name="pillow_room1">
      <static>true</static><pose>-1.5 16.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.6 0.4 0.1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.6 0.4 0.1</size></box></geometry>
          <material><ambient>0.95 0.95 1.0 1</ambient><diffuse>0.95 0.95 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Bedside table room 1 -->
    <model name="bedside_table_1">
      <static>true</static><pose>0.45 15 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 0.4 0.8</size></box></geometry>
          <material><ambient>0.7 0.6 0.4 1</ambient><diffuse>0.7 0.6 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- IV Stand room 1 -->
    <model name="iv_stand_1">
      <static>true</static><pose>-3 15.75 0.9 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.03</radius><length>1.8</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.03</radius><length>1.8</length></cylinder></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- IV Bag -->
    <model name="iv_bag_1">
      <static>true</static><pose>-3 15.75 1.85 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 0.05 0.25</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 0.05 0.25</size></box></geometry>
          <material><ambient>0.7 0.9 0.7 0.8</ambient><diffuse>0.7 0.9 0.7 0.8</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Privacy curtain rail room 1 -->
    <model name="curtain_rail_1">
      <static>true</static><pose>-1.5 13.5 2.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.02</radius><length>3.0</length></cylinder></geometry>
          <pose>0 0 0 0 1.571 0</pose>
        </collision>
        <visual name="vis">
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
          <pose>0 0 0 0 1.571 0</pose>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== PATIENT ROOM 2 (x=3 to 9, y=3 to 12) ===== -->

    <!-- Patient Room 2 Bed -->
    <model name="bed_room2">
      <static>true</static><pose>9 15 0.475 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.95 2.1 0.95</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.95 2.1 0.95</size></box></geometry>
          <material><ambient>1.0 1.0 1.0 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
